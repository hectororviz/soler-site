# Desarrollo local. Copiar a .env y ajustar.
POSTGRES_PASSWORD=csd-local-dev
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/csd_soler?schema=public
JWT_SECRET=cambiar-en-local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar-esta-clave
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
FILES_DIR=/app/uploads
SEED_ON_BOOT=true
VITE_API_URL=http://localhost:3000/api/v1
BACKEND_IMAGE=csd-soler-backend:local
FRONTEND_IMAGE=csd-soler-frontend:local
